# Environment & Deployment Security Mode
ENV=development
SECURE_COOKIES=false

# MongoDB Database URI (Optional - defaults to local SQLite if omitted)
# For production TLS/SSL isolation, add ?tls=true option
MONGODB_URI=mongodb://localhost:27017

# Groq API Key (Required server-side key for Llama-3.3 70B inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Notion Sync Credentials (Optional - for Notion CRM Job Tracker)
NOTION_API_KEY=ntn_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Adzuna Credentials (Optional - for global/India job searching)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
